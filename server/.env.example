PORT=5000
NODE_ENV=development
# CLIENT_URL=http://localhost:5173
# In production, set CLIENT_URL to the exact deployed frontend origin.
# Optional comma-separated additional frontend origins:
# CLIENT_URLS=https://client.example.com,https://staging.example.com

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=auction_token
TRUST_PROXY=1

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AuctionHub <no-reply@auction.local>"

SUPABASE_WEBHOOK_SECRET=generate-a-long-random-webhook-secret
CRON_SECRET=generate-a-long-random-cron-secret
